# ══════════════════════════════════════════════════════════════
# School Management System — Production Environment Template
# ══════════════════════════════════════════════════════════════
# Copy to /opt/school_system/.env and fill in all values.
# NEVER commit this file with real secrets.

# ── Application ─────────────────────────────────────────────────
APP_NAME=School Management System
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# ── Server ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
WORKERS=4
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://school_system:CHANGE_ME_DB_PASSWORD@localhost:5432/school_system
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# ── JWT / Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_ROTATION=true

# ── Argon2 ──────────────────────────────────────────────────────
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── S3-Compatible Storage ───────────────────────────────────────
# Use Cloudflare R2, AWS S3, or DigitalOcean Spaces
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=school-system-uploads
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.example.com

# ── Email ───────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SENDGRID_API_KEY
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# ── Firebase Cloud Messaging (Push Notifications) ──────────────
# FCM_SERVICE_ACCOUNT_PATH=/opt/school_system/firebase-service-account.json

# ── Security ────────────────────────────────────────────────────
MAX_SCHOOLS_PER_INSTANCE=500
MAX_STUDENTS_PER_SCHOOL=5000
MAX_TEACHERS_PER_SCHOOL=200
SESSION_IDLE_TIMEOUT_MINUTES=60
FAILED_LOGIN_LOCKOUT=5
FAILED_LOGIN_WINDOW_MINUTES=15

# ── Sentry (Error Tracking) ─────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
