APP_NAME="School Management System"
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_system
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=school-system-uploads
S3_REGION=auto

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ═══════════════════════════════════════════════════════════════
# M-Pesa Daraja API (Safaricom)
# ═══════════════════════════════════════════════════════════════
# Sandbox test credentials — get yours at https://developer.safaricom.co.ke/
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your-mpesa-passkey-here
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://api.example.com/api/v1/billing/mpesa/callback
# Test phone: use any Safaricom number on sandbox
# Test PIN: sandbox always accepts any PIN

# ═══════════════════════════════════════════════════════════════
# Paystack
# ═══════════════════════════════════════════════════════════════
# Test keys — get yours at https://dashboard.paystack.com/
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Test cards: https://paystack.com/docs/payments/test-payments/
# e.g. 4084084084084081  CVV: 408  Exp: any future date
